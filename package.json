{
  "name": "mail-viewer",
  "version": "1.2.14",
  "scripts": {
    "ng": "ng",
    "update": "ncu -u && npm i && cd server && ncu -u && npm i",
    "server": "node server/main.js &",
    "start": "ng serve --port=4201",
    "prebuild": "eslint src --fix && npm run test:lint",
    "build": "ng build",
    "release": "npm version patch -m \"Upgrade to %s\"",
    "prerelease": "chmod a+x .scripts/pre-release.sh && bash .scripts/pre-release.sh",
    "postrelease": "chmod a+x .scripts/post-release.sh && bash .scripts/post-release.sh",
    "publish": "npm run build",
    "postpublish": "node .scripts/archive.js",
    "test": "ng test",
    "test:lint": "eslint src"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/router": "^22.2.2",
    "archiver": "^8.0.0",
    "cors": "^2.8.6",
    "dompurify": "~3.4.17",
    "express": "^5.3.0",
    "postal-mime": "^4.0.5",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "0.16.2"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.6.0",
    "@angular-eslint/eslint-plugin": "^22.6.0",
    "@angular-eslint/eslint-plugin-template": "^22.6.0",
    "@angular-eslint/schematics": "^22.6.0",
    "@angular-eslint/template-parser": "^22.6.0",
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@types/jasmine": "^5.0.0",
    "@types/jasminewd2": "^2.0.13",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.12.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "^5.0.2",
    "jasmine-spec-reporter": "^5.0.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage-istanbul-reporter": "~3.0.3",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.3.0",
    "ts-node": "~10.9.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.71.2"
  },
  "engines": {
    "node": ">=26",
    "npm": ">=11"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
